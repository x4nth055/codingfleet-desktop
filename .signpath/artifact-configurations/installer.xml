<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "installer": the Windows installer, zipped by
     actions/upload-artifact. The installer says its version with three parts (0.3.0). -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="CodingFleet-Setup-${version}.exe" product-name="CodingFleet" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
