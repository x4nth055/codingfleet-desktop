{
  "name": "codingfleet-desktop",
  "productName": "CodingFleet",
  "version": "0.2.0",
  "description": "The CodingFleet coding agent on your desktop.",
  "license": "MIT",
  "main": "src/main/main.js",
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "e2e": "node test/e2e-run.mjs",
    "test:layout": "electron test/layout.cjs",
    "shot": "electron . --screenshot=shot.png",
    "predist": "node scripts/check-dist-lock.cjs",
    "dist": "electron-builder --win portable",
    "dist:next": "electron-builder --win portable --config.directories.output=dist-next",
    "dist:mac": "electron-builder --mac dmg zip",
    "dist:linux": "electron-builder --linux AppImage deb"
  },
  "build": {
    "appId": "com.codingfleet.desktop",
    "productName": "CodingFleet",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "CodingFleet"
    }
  },
  "dependencies": {
    "@highlightjs/cdn-assets": "^11.12.0",
    "dompurify": "^3.4.15",
    "marked": "^18.0.13"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "homepage": "https://codingfleet.com",
  "author": {
    "name": "CodingFleet",
    "email": "support@codingfleet.com"
  }
}
