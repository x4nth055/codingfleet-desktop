{
  "name": "codingfleet-desktop",
  "productName": "CodingFleet",
  "version": "1.3.0",
  "description": "The CodingFleet coding agent on your desktop.",
  "license": "MIT",
  "main": "src/main/main.js",
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test --test-force-exit \"test/*.test.js\"",
    "e2e": "node test/e2e-run.mjs",
    "e2e:github": "node test/e2e-github.mjs",
    "e2e:background": "node test/e2e-background.mjs",
    "test:layout": "electron test/layout.cjs",
    "test:transcript": "electron test/transcript.cjs",
    "shot": "electron . --screenshot=shot.png",
    "predist": "node scripts/check-dist-lock.cjs",
    "dist": "electron-builder --win nsis",
    "dist:next": "electron-builder --win nsis --config.directories.output=dist-next",
    "dist:mac": "electron-builder --mac dmg zip",
    "dist:linux": "electron-builder --linux AppImage deb",
    "dist:portable": "electron-builder --win portable",
    "icon": "electron scripts/make-icon.cjs",
    "test:browser": "electron test/browser.cjs"
  },
  "build": {
    "appId": "com.codingfleet.desktop",
    "productName": "CodingFleet",
    "copyright": "Copyright (c) CodingFleet",
    "files": [
      "src/**/*",
      "build/icon-256.png",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "npmRebuild": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "enableCookieEncryption": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "x4nth055",
        "repo": "codingfleet-desktop",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "artifactName": "CodingFleet-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CodingFleet",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "CodingFleet-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "CodingFleet-${version}-portable.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Computer use: CodingFleet uses System Events to press keys, type and read other apps' windows for the agent, when you turn it on."
      },
      "artifactName": "CodingFleet-${version}-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "CodingFleet-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "maintainer": "CodingFleet <support@codingfleet.com>",
      "synopsis": "The CodingFleet coding agent on your desktop",
      "artifactName": "CodingFleet-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@fontsource-variable/fira-code": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@highlightjs/cdn-assets": "^11.12.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.15",
    "electron-updater": "^6.8.9",
    "marked": "^18.0.13",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "homepage": "https://codingfleet.com",
  "author": {
    "name": "CodingFleet",
    "email": "support@codingfleet.com"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
